# ============================================================
# LLM provider  (groq | openai | gemini)
# ============================================================
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.5

# Fill in ONLY the key for the provider you are using.
GROQ_API_KEY=your-groq-api-key-here
OPENAI_API_KEY=
GEMINI_API_KEY=

# ============================================================
# RAG / Vector store
# ============================================================
# provisional; recalibrate with real documents and after real LLM tests
RAG_SCORE_THRESHOLD=0.77
RAG_TOP_K=4
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=company_docs_multilingual_e5_small
EMBEDDING_MODEL=multilingual-e5-small

# ============================================================
# Auth  (Phase 4 — not used in Phase 1)
# ============================================================
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ============================================================
# Security, Limits & CORS
# ============================================================
RATE_LIMIT=20/minute
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8000"]
MAX_MESSAGE_LENGTH=1000
MAX_HISTORY_LENGTH=10
MAX_OUTPUT_TOKENS=500

# ============================================================
# App
# ============================================================
APP_ENV=development
LOG_LEVEL=INFO
# Orchestration pipeline mode: langgraph (state-graph orchestrator)
ORCHESTRATOR=langgraph

# ============================================================
# RAG Quality Upgrade Flags (default off)
# ============================================================
# CHUNKING_MODE: section (default legacy word-window) | hierarchical (table & breadcrumb aware)
CHUNKING_MODE=section
# HYBRID_SEARCH: false (default dense vector only) | true (BM25 keyword + dense vector)
HYBRID_SEARCH=false
# RERANKER: false (default top-k cosine similarity) | true (cross-encoder reranking)
RERANKER=false
# QUERY_REWRITE: false (default raw query) | true (history-aware contextual reformulation)
QUERY_REWRITE=false
# GRADER: false (default pass-through) | true (self-correction relevance filtering)
GRADER=false

# ============================================================
# MongoDB (Knowledge Ingestion / Database Storage)
# ============================================================
MONGODB_URI=
MONGODB_DB_NAME=fakhri2_0

