# ==============================================================================
# Chatbot Service - Production Environment Configuration Reference (.env.production.example)
# ==============================================================================
# This template reflects the recommended production settings documented in docs/rag.md.
# Copy to .env for production deployment. Never commit real secrets to version control.

# ------------------------------------------------------------------------------
# 1. LLM Provider & Answer Generation
# ------------------------------------------------------------------------------
LLM_PROVIDER=groq
# Provider selection: groq offers high-throughput low-latency inference for real-time chat

GROQ_API_KEY=your_groq_api_key_here
# Secret API credential for Groq Cloud API; must be kept secret and configured via environment

MODEL=llama-3.3-70b-versatile
# Production answer model: 70B parameter open-weights model balancing reasoning quality and latency

# ------------------------------------------------------------------------------
# 2. Vector Store & Hierarchical Chunking
# ------------------------------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=./chroma_db
# On-disk ChromaDB persistent directory storing ingested markdown document chunks and metadata

CHUNKING_MODE=hierarchical
# Preserves markdown section hierarchy breadcrumbs (# > ## > ###) and table schemas across chunks

TABLE_MAX_ROWS_PER_CHUNK=4
# Splits large markdown tables into 4-row slices with repeated header rows, preventing context truncation

# ------------------------------------------------------------------------------
# 3. Hybrid Retrieval (Dense Vector + Sparse BM25)
# ------------------------------------------------------------------------------
HYBRID_SEARCH=true
# Merges dense vector embeddings with sparse BM25 scoring via Reciprocal Rank Fusion (RRF)

HYBRID_CANDIDATES=8
# Top dense and sparse candidate pools gathered prior to RRF fusion; captures exact codes like P1 or SLA

RAG_TOP_K=5
# Delivers top 5 ranked chunks to the answer generation prompt

RAG_SCORE_THRESHOLD=0.80
# Optimal operating threshold balancing positive acceptance (97.3%) and negative off-topic filtering

# ------------------------------------------------------------------------------
# 4. Conversational Query Rewriting
# ------------------------------------------------------------------------------
QUERY_REWRITE=true
# Reformulates multi-turn follow-ups into standalone search queries when history is present

REWRITE_BACKEND=llm_then_heuristic
# Calls cloud LLM with fast 3s timeout; automatically falls back to local 0.1ms heuristic on timeout/error

REWRITE_MODEL=qwen/qwen3.8-27b
# Fast non-reasoning instruction model with warm p50 latency under 380ms

REWRITE_MODE=replace
# Replaces ambiguous pronouns with standalone queries for retrieval while keeping original in answer prompt

HEURISTIC_VARIANT=f
# Reference marker check or <=2 content terms; selectively extracts assistant domain nouns when user's last message lacks domain context, boosting realistic multi-turn recall to 100% while preventing topic dilution

REWRITE_TIMEOUT_S=3.0
# Upper latency bound on cloud rewriter call before instant local heuristic fallback

# ------------------------------------------------------------------------------
# 5. Post-Retrieval Reranking & Confidence Grading
# ------------------------------------------------------------------------------
RERANKER=false
# Disabled by default for sub-50ms retrieval latency; enable with RERANKER_MODEL=b for high-precision workflows

RERANKER_MODEL=b
# Default cross-encoder model (mmarco-mMiniLMv2) when reranker is enabled

GRADER=false
# Confidence gate; keep disabled unless running reranker in strict automated QA pipelines
